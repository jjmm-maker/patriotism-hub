@import "tailwindcss";

/* ===== GLOBAL THEME ===== */
:root {
  --background: #080b09;
  --foreground: #f0f5f1;
  --panel: #111914;
  --panel-hover: #17251b;
  --border: #293b2e;
  --green: #16a34a;
  --green-light: #86efac;
  --muted: #a3b5a7;
}

@theme inline {
  --color-background: var(--background);
  --color-foreground: var(--foreground);
  --font-sans: var(--font-geist-sans);
  --font-mono: var(--font-geist-mono);
}

* {
  box-sizing: border-box;
}

html {
  min-height: 100%;
  background: var(--background);
}

body {
  min-height: 100vh;
  margin: 0;
  background: var(--background);
  color: var(--foreground);
  font-family: Arial, Helvetica, sans-serif;
  font-size: 14px;
}

button,
input {
  font: inherit;
}

button {
  cursor: pointer;
}

button:focus-visible,
input:focus-visible {
  outline: 2px solid var(--green-light);
  outline-offset: 3px;
}

/* ===== DASHBOARD FRAME ===== */
.hub {
  display: flex;
  min-height: 100vh;
  width: 100%;
  background: var(--background);
  color: var(--foreground);
}

.sidebar {
  position: sticky;
  top: 0;
  display: flex;
  flex: 0 0 258px;
  flex-direction: column;
  width: 258px;
  height: 100vh;
  min-height: 620px;
  padding: 27px 17px 16px;
  background: #0b100c;
  border-right: 1px solid var(--border);
}

.brand {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 0 5px;
  margin-bottom: 39px;
}

.brand-emblem {
  display: grid;
  flex-shrink: 0;
  place-items: center;
  width: 43px;
  height: 43px;
  border-radius: 12px;
  background: var(--green);
  color: white;
  font-size: 24px;
  font-weight: 800;
}

.brand-name {
  color: #f0fdf4;
  font-size: 13px;
  font-weight: 800;
  letter-spacing: 1.7px;
}

.brand-subtitle {
  margin-top: 4px;
  color: var(--green-light);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 2.5px;
}

.workspace-label,
.nav-label {
  margin: 0 7px 11px;
  color: #718276;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 1.5px;
}

.workspace {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 12px 9px;
  margin-bottom: 30px;
  border: 1px solid var(--border);
  border-radius: 10px;
  background: var(--panel);
}

.workspace-icon,
.avatar,
.top-avatar {
  display: grid;
  flex-shrink: 0;
  place-items: center;
  width: 35px;
  height: 35px;
  border-radius: 9px;
  background: #193b25;
  color: var(--green-light);
  font-size: 12px;
  font-weight: 800;
}

.workspace-copy,
.profile-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  gap: 5px;
}

.workspace-copy strong,
.profile-copy strong {
  color: #edf7ef;
  font-size: 11px;
  line-height: 1.4;
}

.workspace-copy span,
.profile-copy span {
  color: var(--muted);
  font-size: 10px;
}

.workspace-arrow {
  color: var(--muted);
}

.navigation {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.nav-item {
  display: flex;
  align-items: center;
  gap: 12px;
  width: 100%;
  min-height: 43px;
  padding: 0 12px;
  border: 1px solid transparent;
  border-radius: 8px;
  background: transparent;
  color: #aebdb1;
  text-align: left;
  font-size: 12px;
  transition: background 150ms ease, color 150ms ease;
}

.nav-item:hover {
  background: #14251a;
  color: #e7f8eb;
}

.nav-item.active {
  border-color: #23462d;
  background: #14251a;
  color: var(--green-light);
  font-weight: 700;
  box-shadow: inset 3px 0 var(--green);
}

.nav-icon {
  display: inline-grid;
  place-items: center;
  width: 19px;
  color: var(--green-light);
  font-size: 17px;
}

.nav-dot {
  width: 6px;
  height: 6px;
  margin-left: auto;
  border-radius: 50%;
  background: #4ade80;
}

.sidebar-bottom {
  margin-top: auto;
}

.help-card {
  padding: 15px;
  border: 1px solid var(--border);
  border-radius: 11px;
  background: var(--panel);
}

.help-symbol {
  margin-bottom: 9px;
  color: var(--green-light);
  font-size: 20px;
}

.help-card strong {
  color: #e7f5e9;
  font-size: 12px;
}

.help-card p {
  margin: 8px 0 0;
  color: var(--muted);
  font-size: 11px;
  line-height: 1.7;
}

.profile {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 17px 3px 0;
  margin-top: 16px;
  border-top: 1px solid var(--border);
}

.profile-menu {
  color: var(--muted);
  letter-spacing: 2px;
}

/* ===== MAIN AREA AND TOP BAR ===== */
.main-area {
  flex: 1;
  min-width: 0;
}

.topbar {
  position: sticky;
  z-index: 5;
  top: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  min-height: 66px;
  padding: 12px 34px;
  border-bottom: 1px solid var(--border);
  background: rgba(11, 16, 12, 0.96);
  backdrop-filter: blur(12px);
}

.breadcrumb {
  display: flex;
  align-items: center;
  gap: 11px;
  color: #94a598;
  font-size: 12px;
}

.breadcrumb-slash {
  color: #536457;
}

.breadcrumb strong {
  color: #effaf1;
  font-weight: 600;
}

.topbar-right {
  display: flex;
  align-items: center;
  gap: 15px;
}

.preview-badge {
  display: flex;
  align-items: center;
  gap: 7px;
  padding: 7px 10px;
  border: 1px solid #31583b;
  border-radius: 20px;
  color: #bbf7d0;
  font-size: 10px;
}

.status-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #4ade80;
}

.icon-button {
  display: grid;
  place-items: center;
  width: 34px;
  height: 34px;
  border: 1px solid var(--border);
  border-radius: 9px;
  background: var(--panel);
  color: #c5d7c8;
}

.top-avatar {
  width: 33px;
  height: 33px;
  border-radius: 50%;
}

/* ===== PAGE CONTENT ===== */
.page-content {
  width: 100%;
  max-width: 1550px;
  padding: 34px;
  margin: 0 auto;
}

.welcome-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  margin-bottom: 27px;
}

.eyebrow {
  margin-bottom: 12px;
  color: var(--green-light);
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 1.7px;
}

.welcome-row h1 {
  margin: 0;
  color: #f2fbf4;
  font-size: clamp(25px, 3vw, 34px);
  font-weight: 750;
  letter-spacing: -1px;
}

.welcome-description {
  max-width: 590px;
  margin: 11px 0 0;
  color: #a3b5a7;
  font-size: 13px;
  line-height: 1.8;
}

.primary-button,
.banner-button {
  display: inline-flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  gap: 9px;
  min-height: 42px;
  padding: 0 17px;
  border: 1px solid var(--green);
  border-radius: 8px;
  background: var(--green);
  color: white;
  font-size: 12px;
  font-weight: 700;
  transition: background 150ms ease;
}

.primary-button:hover,
.banner-button:hover {
  background: #15803d;
}

.primary-button span {
  font-size: 18px;
}

/* ===== NOTICE ===== */
.notice {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 15px;
  padding: 13px 15px;
  margin-bottom: 22px;
  border: 1px solid #31583b;
  border-radius: 9px;
  background: #14251a;
  color: #dcfce7;
  font-size: 12px;
  line-height: 1.7;
}

.notice button {
  border: 0;
  background: transparent;
  color: #bbf7d0;
  font-size: 20px;
}

/* ===== HERO BANNER ===== */
.welcome-banner {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  min-height: 235px;
  overflow: hidden;
  padding: 32px 35px;
  margin-bottom: 34px;
  border: 1px solid #285a37;
  border-radius: 15px;
  background: linear-gradient(115deg, #10271a, #123d24 58%, #0c2114);
}

.banner-content {
  position: relative;
  z-index: 2;
  max-width: 600px;
}

.banner-tag {
  display: flex;
  align-items: center;
  gap: 8px;
  color: #bbf7d0;
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 1.5px;
}

.banner-tag-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #4ade80;
}

.banner-content h2 {
  margin: 20px 0 11px;
  color: #f0fdf4;
  font-size: clamp(22px, 2.7vw, 31px);
  line-height: 1.25;
  letter-spacing: -0.7px;
}

.banner-content p {
  max-width: 510px;
  margin: 0;
  color: #c0d6c5;
  font-size: 12px;
  line-height: 1.8;
}

.banner-button {
  min-height: 38px;
  margin-top: 22px;
  border-color: #4ade80;
  background: #16a34a;
}

.banner-art {
  position: relative;
  display: grid;
  flex: 0 0 195px;
  place-items: center;
  min-height: 165px;
  color: #bbf7d0;
}

.art-orbit {
  position: absolute;
  width: 155px;
  height: 155px;
  border: 1px solid rgba(134, 239, 172, 0.3);
  border-radius: 50%;
}

.orbit-one {
  transform: scaleX(0.56) rotate(35deg);
}

.orbit-two {
  transform: scaleX(0.56) rotate(-35deg);
}

.art-circle {
  position: relative;
  display: grid;
  place-items: center;
  width: 78px;
  height: 78px;
  border: 1px solid #4ade80;
  border-radius: 50%;
  background: rgba(7, 25, 13, 0.55);
  color: #dcfce7;
  font-size: 22px;
  font-weight: 800;
}

.art-star {
  position: absolute;
  top: -7px;
  right: -4px;
  color: #86efac;
  font-size: 23px;
}

.art-caption {
  position: absolute;
  bottom: -3px;
  color: #a7d9b4;
  font-size: 8px;
  font-weight: 800;
  letter-spacing: 2px;
}

/* ===== SECTION HEADINGS ===== */
.section-heading,
.panel-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
}

.section-heading {
  margin-bottom: 18px;
}

.section-heading h2,
.panel-heading h2 {
  margin: 0;
  color: #effaf1;
  font-size: 16px;
  font-weight: 700;
}

.section-heading p,
.panel-heading p {
  margin: 7px 0 0;
  color: #96a99a;
  font-size: 11px;
  line-height: 1.6;
}

.period-label {
  padding: 7px 10px;
  border: 1px solid #31583b;
  border-radius: 6px;
  color: #86efac;
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 0.7px;
  white-space: nowrap;
}

/* ===== STATISTICS CARDS ===== */
.stat-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 15px;
  margin-bottom: 27px;
}

.stat-card {
  min-width: 0;
  padding: 19px;
  border: 1px solid var(--border);
  border-radius: 12px;
  background: var(--panel);
  transition: border-color 150ms ease, transform 150ms ease;
}

.stat-card:hover {
  transform: translateY(-2px);
  border-color: #426849;
}

.stat-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}

.stat-icon {
  display: grid;
  place-items: center;
  width: 35px;
  height: 35px;
  border-radius: 9px;
  background: #193524;
  color: #86efac;
  font-size: 18px;
}

.stat-label {
  color: #829586;
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 1px;
}

.stat-value {
  margin-top: 22px;
  color: #4ade80;
  font-size: 28px;
  font-weight: 750;
  letter-spacing: -0.5px;
}

.stat-title {
  margin-top: 7px;
  color: #e3eee5;
  font-size: 12px;
  font-weight: 700;
}

.stat-foot {
  margin-top: 8px;
  color: #8da092;
  font-size: 10px;
  line-height: 1.5;
}

/* ===== LOWER CONTENT PANELS ===== */
.content-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.25fr) minmax(290px, 0.85fr);
  align-items: start;
  gap: 18px;
}

.panel {
  min-width: 0;
  padding: 22px;
  border: 1px solid var(--border);
  border-radius: 13px;
  background: var(--panel);
}

.panel-heading {
  margin-bottom: 19px;
}

.text-button {
  padding: 5px 0 5px 8px;
  border: 0;
  background: transparent;
  color: #4ade80;
  font-size: 11px;
  font-weight: 700;
  white-space: nowrap;
}

.text-button span {
  margin-left: 4px;
}

.panel-more {
  color: #96a99a;
  letter-spacing: 2px;
}

/* ===== SEARCH ===== */
.search-box {
  display: flex;
  align-items: center;
  gap: 10px;
  min-height: 41px;
  padding: 0 12px;
  margin-bottom: 6px;
  border: 1px solid #344638;
  border-radius: 8px;
  background: #080b09;
  color: #91a697;
}

.search-box > span {
  font-size: 19px;
}

.search-box input {
  flex: 1;
  width: 100%;
  min-width: 0;
  padding: 10px 0;
  border: 0;
  outline: none;
  background: transparent;
  color: #f0fdf4;
  font-size: 11px;
}

.search-box input::placeholder {
  color: #819286;
}

.search-box button {
  border: 0;
  background: transparent;
  color: #bbf7d0;
  font-size: 18px;
}

/* ===== ANNOUNCEMENTS ===== */
.announcement-list {
  display: flex;
  flex-direction: column;
}

.announcement {
  display: flex;
  align-items: flex-start;
  gap: 13px;
  padding: 19px 0;
  border-bottom: 1px solid #26352a;
}

.announcement:last-child {
  border-bottom: 0;
  padding-bottom: 5px;
}

.announcement-marker {
  display: grid;
  flex: 0 0 35px;
  place-items: center;
  width: 35px;
  height: 35px;
  border-radius: 9px;
  background: #193524;
  color: #86efac;
  font-size: 16px;
}

.announcement-marker.blue {
  background: #162c24;
  color: #86efac;
}

.announcement-marker.green {
  background: #193524;
  color: #86efac;
}

.announcement-body {
  flex: 1;
  min-width: 0;
}

.announcement-category {
  margin-bottom: 7px;
  color: #86c99a;
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 0.8px;
}

.announcement h3 {
  margin: 0;
  color: #edf7ef;
  font-size: 12px;
  line-height: 1.6;
}

.announcement p {
  margin: 7px 0 9px;
  color: #a3b5a7;
  font-size: 11px;
  line-height: 1.8;
}

.announcement-date {
  color: #819286;
  font-size: 10px;
}

.announcement-arrow {
  color: #4ade80;
  font-size: 14px;
}

.empty-state {
  padding: 28px 8px;
  color: #a3b5a7;
  text-align: center;
  font-size: 12px;
}

/* ===== PROGRAMME CENTRE ===== */
.activity-list {
  display: flex;
  flex-direction: column;
}

.activity-item {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  width: 100%;
  padding: 15px 0;
  border: 0;
  border-bottom: 1px solid #26352a;
  background: transparent;
  color: inherit;
  text-align: left;
}

.activity-item:hover .activity-copy strong {
  color: #86efac;
}

.activity-avatar {
  display: grid;
  flex: 0 0 37px;
  place-items: center;
  width: 37px;
  height: 37px;
  border-radius: 10px;
  background: #193524;
  color: #86efac;
  font-size: 10px;
  font-weight: 800;
}

.activity-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  gap: 6px;
}

.activity-copy strong {
  color: #eaf5ec;
  font-size: 11px;
  line-height: 1.5;
}

.activity-copy span {
  color: #9bad9f;
  font-size: 10px;
  line-height: 1.5;
}

.activity-copy .coming-soon {
  color: #86efac;
  font-size: 10px;
}

.activity-arrow {
  padding-top: 5px;
  color: #4ade80;
}

.coordination-note {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  padding: 15px;
  margin-top: 20px;
  border: 1px solid #2b4a32;
  border-radius: 10px;
  background: #14251a;
}

.note-icon {
  color: #86efac;
  font-size: 19px;
}

.coordination-note strong {
  color: #e5f6e9;
  font-size: 11px;
}

.coordination-note p {
  margin: 7px 0 0;
  color: #a3b5a7;
  font-size: 10px;
  line-height: 1.8;
}

/* ===== FOOTER ===== */
.footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 22px 0 5px;
  margin-top: 24px;
  border-top: 1px solid #26352a;
  color: #829586;
  font-size: 10px;
}

/* ===== AUTHENTICATION ===== */
.auth-shell {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 32px 18px;
  background:
    radial-gradient(ellipse at top, rgba(22, 163, 74, 0.14), transparent 55%),
    #080b09;
  color: #f5f5f7;
}

.auth-card {
  width: 100%;
  max-width: 440px;
  padding: 36px;
  border: 1px solid var(--border);
  border-radius: 18px;
  background: #111914;
  box-shadow: 0 24px 70px rgba(0, 0, 0, 0.28);
}

.auth-emblem {
  display: grid;
  place-items: center;
  width: 52px;
  height: 52px;
  margin-bottom: 22px;
  border-radius: 14px;
  background: var(--green);
  color: #fff;
  font-size: 27px;
  font-weight: 800;
}

.auth-kicker {
  margin: 0 0 10px;
  color: var(--green-light);
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 2px;
}

.auth-card h1 {
  margin: 0 0 12px;
  color: #fff;
  font-size: 28px;
  line-height: 1.25;
}

.auth-description,
.auth-card > p {
  color: #a7b5aa;
  font-size: 14px;
  line-height: 1.7;
}

.auth-label {
  display: block;
  margin-top: 18px;
  color: #e5e5e7;
  font-size: 13px;
  font-weight: 600;
}

.auth-feedback {
  padding: 12px;
  border: 1px solid #31583b;
  border-radius: 8px;
  background: #14251a;
  color: #bbf7d0;
  font-size: 13px;
  line-height: 1.6;
  overflow-wrap: anywhere;
}

.auth-switch {
  margin: 24px 0 0;
  color: #a7b5aa;
  text-align: center;
  font-size: 13px;
}

.auth-switch button {
  padding: 0;
  border: 0;
  background: transparent;
  color: #4ade80;
  font: inherit;
  font-weight: 700;
  cursor: pointer;
}

.auth-message {
  display: grid;
  place-items: center;
  min-height: 100vh;
  background: #080b09;
  color: #f5f5f7;
}

/* ===== RESPONSIVE LAYOUT ===== */
@media (min-width: 1500px) {
  .page-content {
    padding: 42px;
  }

  .stat-card {
    padding: 23px;
  }
}

@media (max-width: 1100px) {
  .sidebar {
    flex-basis: 225px;
    width: 225px;
    padding-right: 12px;
    padding-left: 12px;
  }

  .page-content {
    padding: 25px;
  }

  .stat-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .content-grid {
    grid-template-columns: minmax(0, 1fr);
  }

  .banner-art {
    flex-basis: 150px;
  }
}

@media (max-width: 700px) {
  .hub {
    display: block;
  }

  .sidebar {
    position: static;
    width: 100%;
    height: auto;
    min-height: 0;
    padding: 15px;
    border-right: 0;
    border-bottom: 1px solid var(--border);
  }

  .brand {
    margin-bottom: 18px;
  }

  .workspace-label,
  .workspace,
  .sidebar-bottom,
  .nav-label {
    display: none;
  }

  .navigation {
    display: flex;
    flex-direction: row;
    gap: 7px;
    overflow-x: auto;
    padding-bottom: 4px;
  }

  .nav-item {
    flex: 0 0 auto;
    width: auto;
    min-height: 38px;
    padding: 0 10px;
    font-size: 11px;
  }

  .nav-item.active {
    box-shadow: inset 0 -2px var(--green);
  }

  .nav-icon {
    width: auto;
    font-size: 15px;
  }

  .topbar {
    position: static;
    min-height: 55px;
    padding: 10px 16px;
  }

  .topbar-right {
    gap: 8px;
  }

  .preview-badge {
    padding: 6px 8px;
  }

  .page-content {
    padding: 24px 16px;
  }

  .welcome-row {
    align-items: flex-start;
    flex-direction: column;
    gap: 17px;
  }

  .welcome-row h1 {
    font-size: 28px;
  }

  .welcome-banner {
    min-height: 0;
    padding: 25px 22px;
  }

  .banner-art {
    display: none;
  }

  .section-heading {
    align-items: flex-start;
  }

  .section-heading h2 {
    font-size: 15px;
  }

  .period-label {
    font-size: 8px;
  }

  .stat-grid {
    gap: 11px;
  }

  .stat-card {
    padding: 14px;
  }

  .stat-value {
    font-size: 25px;
  }

  .panel {
    padding: 17px;
  }

  .footer {
    align-items: flex-start;
    flex-direction: column;
  }
}

@media (max-width: 380px) {
  .stat-grid {
    grid-template-columns: minmax(0, 1fr);
  }

  .auth-card {
    padding: 25px 20px;
  }

  .auth-card h1 {
    font-size: 24px;
  }

  .breadcrumb {
    gap: 6px;
    font-size: 10px;
  }

  .top-avatar {
    display: none;
  }
}

/* Database-connected announcements */
.announcement-create-button {
  min-height: 35px;
  padding: 0 12px;
  font-size: 11px;
}

.announcement-feedback {
  padding: 11px 13px;
  margin-bottom: 15px;
  border: 1px solid #31583b;
  border-radius: 8px;
  background: #14251a;
  color: #bbf7d0;
  font-size: 12px;
  line-height: 1.6;
  overflow-wrap: anywhere;
}

.announcement-form {
  display: flex;
  flex-direction: column;
  gap: 14px;
  padding: 17px;
  margin-bottom: 18px;
  border: 1px solid #293b2e;
  border-radius: 10px;
  background: #0b100c;
}

.announcement-form label {
  display: flex;
  flex-direction: column;
  gap: 7px;
  color: #dce9df;
  font-size: 12px;
  font-weight: 600;
}

.announcement-form input,
.announcement-form select,
.announcement-form textarea {
  width: 100%;
  padding: 11px 12px;
  border: 1px solid #344638;
  border-radius: 7px;
  background: #080b09;
  color: #f0fdf4;
  font-size: 12px;
}

.announcement-form textarea {
  resize: vertical;
  line-height: 1.7;
}

.announcement-form input::placeholder,
.announcement-form textarea::placeholder {
  color: #819286;
}

.announcement-form button:disabled {
  cursor: wait;
  opacity: 0.65;
}

.announcement-text {
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}

.announcement-empty {
  padding: 25px 10px;
  color: #a3b5a7;
  text-align: center;
  font-size: 12px;
  line-height: 1.7;
}

/* ===== Schools page: readability and clearer sections ===== */

.schools-panel {
  width: 100%;
  max-width: 1400px;
  margin: 0 auto;
  padding: 28px;
  color: #f3f7f3;
  font-size: 16px;
  line-height: 1.75;
  letter-spacing: 0.15px;
  word-spacing: 1px;
}

.schools-panel h1,
.schools-panel h2,
.schools-panel h3 {
  color: #ffffff;
  line-height: 1.4;
  letter-spacing: 0.2px;
  margin-bottom: 14px;
}

.schools-panel h1 {
  font-size: clamp(28px, 3vw, 36px);
  font-weight: 800;
}

.schools-panel h2 {
  font-size: 23px;
  font-weight: 750;
}

.schools-panel h3 {
  font-size: 19px;
  font-weight: 700;
}

.schools-panel p,
.schools-panel label,
.schools-panel td,
.schools-panel th {
  font-size: 16px;
  line-height: 1.7;
}

.schools-panel label {
  display: block;
  margin-bottom: 7px;
  color: #e1ebe3;
  font-weight: 650;
}

.schools-panel input,
.schools-panel select,
.schools-panel textarea,
.schools-search input {
  width: 100%;
  min-height: 50px;
  padding: 13px 15px;
  border: 1px solid #42634b;
  border-radius: 10px;
  background: #111b14;
  color: #f5fff6;
  font-size: 16px;
  line-height: 1.5;
  letter-spacing: 0.15px;
  outline: none;
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

.schools-panel input::placeholder,
.schools-panel textarea::placeholder,
.schools-search input::placeholder {
  color: #a2b3a5;
  opacity: 1;
}

.schools-panel input:focus,
.schools-panel select:focus,
.schools-panel textarea:focus,
.schools-search input:focus {
  border-color: #35c759;
  box-shadow: 0 0 0 3px rgba(53, 199, 89, 0.16);
}

.school-form {
  display: grid;
  gap: 20px;
  margin: 24px 0;
  padding: 26px;
  border: 1px solid #35553d;
  border-radius: 16px;
  background: #121a14;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.16);
}

.school-form button,
.schools-panel button {
  min-height: 44px;
  padding: 11px 18px;
  border-radius: 9px;
  font-size: 15px;
  font-weight: 700;
  line-height: 1.5;
  cursor: pointer;
}

.schools-summary {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 18px;
  margin: 24px 0;
}

.schools-summary > * {
  padding: 20px;
  border: 1px solid #35553d;
  border-radius: 14px;
  background: #121a14;
}

.schools-search {
  margin: 22px 0;
}

.schools-table-wrap {
  width: 100%;
  margin-top: 22px;
  overflow-x: auto;
  border: 1px solid #35553d;
  border-radius: 14px;
  background: #111713;
}

.schools-table {
  width: 100%;
  border-collapse: collapse;
  min-width: 620px;
}

.schools-table th {
  padding: 17px 20px;
  background: #1b2a1e;
  color: #b9f5c4;
  text-align: left;
  font-size: 14px;
  font-weight: 800;
  letter-spacing: 0.4px;
  border-bottom: 1px solid #42634b;
}

.schools-table td {
  padding: 17px 20px;
  border-bottom: 1px solid #2a3a2e;
  color: #e7eee8;
  vertical-align: middle;
  overflow-wrap: anywhere;
}

.schools-table tbody tr:hover {
  background: #19241c;
}

.schools-table tbody tr:last-child td {
  border-bottom: none;
}

.school-status {
  display: inline-block;
  padding: 5px 11px;
  border: 1px solid currentColor;
  border-radius: 20px;
  font-size: 13px;
  font-weight: 750;
  line-height: 1.5;
}

.school-empty,
.school-message {
  margin: 20px 0;
  padding: 18px 20px;
  border: 1px solid #42634b;
  border-radius: 12px;
  background: #121a14;
  color: #e6f4e9;
  font-size: 16px;
  line-height: 1.75;
}

.school-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

@media (max-width: 640px) {
  .schools-panel {
    padding: 16px;
    font-size: 16px;
  }

  .school-form {
    padding: 18px;
    gap: 16px;
  }

  .schools-table th,
  .schools-table td {
    padding: 13px 14px;
  }
}

